prepare() {
  # @electron/asar and its dependencies where `npm ci --ignore-scripts` puts them.
  cd electron-transplant
  rm -rf node_modules
  local module
  for module in \
    'node_modules/@electron/asar:@electron+asar-4.3.1.tgz' \
    'node_modules/balanced-match:balanced-match-4.0.4.tgz' \
    'node_modules/brace-expansion:brace-expansion-5.0.13.tgz' \
    'node_modules/glob:glob-13.0.7.tgz' \
    'node_modules/lru-cache:lru-cache-11.5.3.tgz' \
    'node_modules/minimatch:minimatch-10.2.6.tgz' \
    'node_modules/minipass:minipass-7.1.3.tgz' \
    'node_modules/path-scurry:path-scurry-2.0.2.tgz'
  do
    mkdir -p "${module%%:*}"
    tar -xzf "$srcdir/${module#*:}" -C "${module%%:*}" --strip-components 1
  done
}

build() {
  cd electron-transplant
  # Offline: only the files above, nothing from the network or $HOME.
  rm -rf "$srcdir/build"
  node bin/electron-transplant build figma --offline --out "$srcdir/build" \
    --inputs "$srcdir" --dmg "$srcdir"/'Figma-126.11.9.dmg' --sevenzip /usr/lib/7zip/7z
}

package() {
  cd electron-transplant
  node bin/electron-transplant install figma --from "$srcdir/build" \
    --layout package --prefix /usr --destdir "$pkgdir"
  # Licences (Electron, Chromium, electron-transplant) are in usr/share/licenses/figma-desktop.
  ln -s figma-desktop "$pkgdir/usr/share/licenses/$pkgname"
}
